      objectReference: {fileID: 0}
    - target: {fileID: 6208423592588017335, guid: a9398dfcd2613224e99f9f38b9323f9c, type: 3}
      propertyPath: readableText
      value: "Asunto: Infiltraci\xF3n inminente de la Casa Lovelace \n\r\nA la atenci\xF3n
        del Capit\xE1n de Guardia Graves,\n\r\nNuestros informantes en los Anillos
        de Hierro han detectado un flujo inusual de actividad en las redes del Ojo
        Imperial. La Casa Lovelace sabe lo que custodiamos en el s\xF3tano. En las
        \xFAltimas 48 horas, hemos identificado al menos a tres individuos en el
        per\xEDmetro exterior cuyos perfiles encajan con las sombras de Lord Alistair
        Lovelace. Est\xE1n operando encubiertos entre el personal de mantenimiento
        y los proveedores de Aevar.\r\nSi la Red del Ojo pone sus manos en esos documentos
        antes de que nosotros podamos destruirlos o trasladarlos, la furia de los
        Armstrong caer\xE1 sobre la Casa Vickers y no quedar\xE1 nada de nosotros.
        Redoblen la seguridad en el ala este, refuercen la doble cerradura y no conf\xEDen
        en nadie que no estuviera asignado a esta base hace una semana.\r\n"
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: a9398dfcd2613224e99f9f38b9323f9c, type: 3}
