    - target: {fileID: 6208423592588017335, guid: a9398dfcd2613224e99f9f38b9323f9c, type: 3}
      propertyPath: image
      value: 
      objectReference: {fileID: 21300000, guid: 5008e4c9d163e144f84b80214b07521e, type: 3}
    - target: {fileID: 6208423592588017335, guid: a9398dfcd2613224e99f9f38b9323f9c, type: 3}
      propertyPath: readableText
      value: "Reporte de Interrogatorio - Sujeto: Zeke Higgs\r\nSupervisado por:
        Suboficial de Inteligencia Vickers\r\nTras la aplicaci\xF3n de vapores c\xE1usticos
        en bajas dosis y m\xE9todos de presi\xF3n f\xEDsica continuada, el sujeto
        se ha quebrado. Ha confirmado que la c\xE9lula insurrecta planeaba utilizar
        los archivos del 'Overlord' para enviarlos directamente a los cuarteles generales
        de la Casa Armstrong, buscando desatar una guerra civil abierta entre las
        Doce Casas.\r\nA\xFAn m\xE1s alarmante, el sujeto ha revelado las ubicaciones
        de tres pisos francos de la resistencia en el distrito obrero n.65 de Nueva
        Birmingham y los nombres de dos contactos que trabajan infiltrados en la
        log\xEDstica ferroviaria imperial. Recomiendo enviar estos datos inmediatamente
        al Alto Mando antes de que las Sombras de Lovelace intercepten esta informaci\xF3n
        y la usen para extorsionarnos.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6208423592588017335, guid: a9398dfcd2613224e99f9f38b9323f9c, type: 3}
      propertyPath: isZekeTortureReport
      value: 1
      objectReference: {fileID: 0}
